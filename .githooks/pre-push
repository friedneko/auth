#!/usr/bin/env bash
#
# .githooks/pre-push   (tracked, shareable)
#
# Gates every `git push` behind the project's quality checks:
#   1. format   — `oxfmt --check .`  (fails if any file is unformatted)
#   2. lint     — `oxlint .`         (fails on any lint error)
#
# The push is aborted if ANY check fails. Bypass for one push with `git push --no-verify`.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

export CI=true

echo "▶ pre-push: running format check and lint gate..."

if ! pnpm run format:check; then
  echo ""
  echo "✖ pre-push: formatting check failed."
  echo "  Run 'pnpm format' to auto-fix, then re-stage & retry the push."
  exit 1
fi

if ! pnpm run lint; then
  echo ""
  echo "✖ pre-push: lint failed."
  echo "  Fix the reported issues, then retry the push."
  exit 1
fi

echo "✓ pre-push: format + lint passed"
exit 0
